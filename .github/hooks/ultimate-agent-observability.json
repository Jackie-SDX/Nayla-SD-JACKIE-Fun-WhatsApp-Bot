{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash .github/scripts/log-copilot-hook.sh",
        "timeoutSec": 5
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "bash .github/scripts/log-copilot-hook.sh",
        "timeoutSec": 5
      }
    ]
  }
}

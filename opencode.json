{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "default_agent": "build",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "share": "disabled",
  "subagent_depth": 2,
  "mcp": {
    "composio": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "mcp-remote@0.14.2",
        "{env:COMPOSIO_MCP_URL}",
        "--transport",
        "http-only",
        "--header-file",
        "{env:COMPOSIO_MCP_HEADERS_FILE}"
      ],
      "enabled": true,
      "timeout": 20000
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "deny",
      ".npmrc": "deny"
    },
    "bash": {
      "*": "allow",
      "git commit *": "deny",
      "git commit": "deny",
      "git push *": "deny",
      "git push": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git branch -D *": "deny",
      "git branch -d *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny"
    },
    "external_directory": "deny",
    "doom_loop": "deny",
    "task": {
      "*": "deny",
      "architect-reviewer": "allow",
      "adversarial-reviewer": "allow",
      "adjudicator": "allow",
      "verifier": "allow"
    }
  }
}

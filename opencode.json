{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "default_agent": "build",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "share": "disabled",
  "mcp": {
    "composio": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "mcp-remote@0.14.2",
        "{env:COMPOSIO_MCP_URL}",
        "--transport",
        "http-only",
        "--header-file",
        "{env:COMPOSIO_MCP_HEADERS_FILE}"
      ],
      "enabled": true,
      "timeout": 20000
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "deny",
      ".npmrc": "deny"
    },
    "bash": {
      "*": "allow",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push --force-with-lease *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny"
    },
    "external_directory": "allow",
    "doom_loop": "allow",
    "question": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "todoread": "allow"
  }
}

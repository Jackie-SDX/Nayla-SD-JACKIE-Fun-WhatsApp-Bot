{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.8-flash",
  "default_agent": "build",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "share": "disabled",
  "subagent_depth": 2,
  "enabled_providers": [
    "google",
    "openrouter"
  ],
  "provider": {
    "google": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}",
        "timeout": 180000,
        "headerTimeout": 15000,
        "chunkTimeout": 30000
      },
      "models": {
        "gemini-3.8-flash": {},
        "gemini-3.7-flash": {},
        "gemini-3.6-flash": {},
        "gemini-3.5-flash": {},
        "gemini-3.5-flash-lite": {}
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "timeout": 180000,
        "headerTimeout": 15000,
        "chunkTimeout": 30000
      },
      "models": {
        "free": {}
      }
    }
  },
  "mcp": {
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "x-consumer-api-key": "{env:COMPOSIO_API_KEY}"
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "deny",
      ".npmrc": "deny"
    },
    "bash": {
      "*": "allow",
      "git commit *": "deny",
      "git commit": "deny",
      "git push *": "deny",
      "git push": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git branch -D *": "deny",
      "git branch -d *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny"
    },
    "external_directory": "deny",
    "doom_loop": "deny"
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "default_agent": "build",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "share": "disabled",
  "mcp": {
    "composio": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "mcp-remote@0.14.2",
        "{env:COMPOSIO_MCP_URL}",
        "--transport",
        "http-only",
        "--header-file",
        "{env:COMPOSIO_MCP_HEADERS_FILE}"
      ],
      "enabled": true,
      "timeout": 20000
    }
  },
  "update": "disable",
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".npmrc",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".npmrc",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git branch -d *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git branch -D *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git merge *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git rebase *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git tag *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git update-ref *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git replace *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git notes *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "curl *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wget *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "ssh *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "scp *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm publish *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "env",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "env *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "printenv",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "printenv *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "set",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "doom_loop",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todoread",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ]
}

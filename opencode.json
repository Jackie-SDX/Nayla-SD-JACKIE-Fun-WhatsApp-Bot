{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "default_agent": "build",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "share": "disabled",
  "mcp": {
    "composio": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "mcp-remote@0.14.2",
        "{env:COMPOSIO_MCP_URL}",
        "--transport",
        "http-only",
        "--header-file",
        "{env:COMPOSIO_MCP_HEADERS_FILE}"
      ],
      "enabled": true,
      "timeout": 20000
    }
  },
  "permission": "allow"
}
